  <script>
  // State
  let allData = [];
  let ratings = { comfort: 0, effectiveness: 0, design: 0, value: 0, overall: 0 };
  const currentRecordCount = () => allData.length;

  const defaultConfig = {
    app_title: 'NeuroBlandSleep+',
    app_subtitle: 'Central de Feedback',
    survey_intro: 'Sua opinião é essencial para continuarmos melhorando sua experiência de sono',
    thank_you_message: 'Obrigado pelo seu feedback!',
    background_color: '#0f0b2e',
    surface_color: 'rgba(255,255,255,0.04)',
    text_color: '#e0e7ff',
    primary_action_color: '#6366f1',
    secondary_action_color: '#a5b4fc',
    font_family: 'DM Sans',
    font_size: 14
  };

  // Build star ratings
  function buildStars() {
    ['comfort','effectiveness','design','value','overall'].forEach(key => {
      const container = document.getElementById('stars-' + key);
      if (!container) return;
      container.innerHTML = '';
      for (let i = 1; i <= 5; i++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'star-btn' + (i <= ratings[key] ? ' active' : '');
        btn.setAttribute('aria-label', `${i} estrela${i > 1 ? 's' : ''}`);
        btn.style.color = i <= ratings[key] ? '#fbbf24' : '#4b5563';
        btn.innerHTML = `<svg width="28" height="28" viewBox="0 0 24 24" fill="${i <= ratings[key] ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
        btn.onclick = () => { ratings[key] = i; buildStars(); };
        container.appendChild(btn);
      }
    });
  }

  // Tabs
  function switchTab(tab) {
    const tabs = ['survey','complaint','suggestion','praise','history'];
    tabs.forEach(t => {
      const panel = document.getElementById('panel-' + t);
      const btn = document.getElementById('tab-' + t);
      if (t === tab) {
        panel.classList.remove('hidden');
        panel.classList.add('fade-in');
        btn.classList.add('active');
        btn.style.background = 'rgba(99,102,241,0.25)';
        btn.style.color = '#a5b4fc';
        btn.style.borderColor = 'rgba(99,102,241,0.4)';
        btn.setAttribute('aria-selected', 'true');
      } else {
        panel.classList.add('hidden');
        btn.classList.remove('active');
        btn.style.background = 'rgba(255,255,255,0.05)';
        btn.style.color = '#7c85b3';
        btn.style.borderColor = 'rgba(255,255,255,0.08)';
        btn.setAttribute('aria-selected', 'false');
      }
    });
  }

  // Toast
  function showToast(msg, type) {
    const c = document.getElementById('toast-container');
    const t = document.createElement('div');
    const colors = { success: '#22c55e', error: '#ef4444', info: '#6366f1' };
    t.className = 'toast-enter flex items-center gap-2 px-4 py-3 rounded-xl text-sm font-medium shadow-lg';
    t.style.cssText = `background: ${colors[type] || colors.info}; color: white; min-width: 250px;`;
    const icons = { success: 'check-circle', error: 'x-circle', info: 'info' };
    t.innerHTML = `<i data-lucide="${icons[type] || 'info'}" style="width:18px;height:18px;flex-shrink:0;"></i><span>${msg}</span>`;
    c.appendChild(t);
    lucide.createIcons();
    setTimeout(() => { t.classList.replace('toast-enter','toast-exit'); setTimeout(() => t.remove(), 300); }, 3000);
  }

  // Survey submit
  async function handleSurveySubmit(e) {
    e.preventDefault();
    if (currentRecordCount() >= 999) { showToast('Limite de 999 registros atingido.', 'error'); return; }
    const allRated = Object.values(ratings).every(r => r > 0);
    if (!allRated) { showToast('Por favor, avalie todas as categorias.', 'error'); return; }
    const rec = document.querySelector('input[name="recommend"]:checked');
    if (!rec) { showToast('Indique se recomendaria o produto.', 'error'); return; }

    const btn = document.getElementById('survey-submit');
    btn.classList.add('submit-loading');
    btn.querySelector('span').textContent = 'Enviando...';

    const result = await window.dataSdk.create({
      type: 'pesquisa',
      name: document.getElementById('survey-name').value,
      email: document.getElementById('survey-email').value,
      rating_comfort: ratings.comfort,
      rating_effectiveness: ratings.effectiveness,
      rating_design: ratings.design,
      rating_value: ratings.value,
      rating_overall: ratings.overall,
      recommend: rec.value,
      usage_time: document.getElementById('survey-usage').value,
      message: document.getElementById('survey-message').value || '',
      created_at: new Date().toISOString()
    });

    btn.classList.remove('submit-loading');
    btn.querySelector('span').textContent = 'Enviar Pesquisa';

    if (result.isOk) {
      const cfg = window.elementSdk ? window.elementSdk.config : {};
      showToast(cfg.thank_you_message || defaultConfig.thank_you_message, 'success');
      document.getElementById('survey-form').reset();
      ratings = { comfort: 0, effectiveness: 0, design: 0, value: 0, overall: 0 };
      buildStars();
    } else {
      showToast('Erro ao enviar. Tente novamente.', 'error');
    }
  }

  // Generic submit (complaint, suggestion, praise)
  async function handleGenericSubmit(e, type) {
    e.preventDefault();
    if (currentRecordCount() >= 999) { showToast('Limite de 999 registros atingido.', 'error'); return; }

    const form = e.target;
    const btn = form.querySelector('.generic-submit');
    btn.classList.add('submit-loading');
    btn.querySelector('span').textContent = 'Enviando...';

    const prefix = type === 'reclamação' ? 'complaint' : type === 'sugestão' ? 'suggestion' : 'praise';
    const result = await window.dataSdk.create({
      type: type,
      name: document.getElementById(prefix + '-name').value,
      email: document.getElementById(prefix + '-email').value,
      rating_comfort: 0, rating_effectiveness: 0, rating_design: 0, rating_value: 0, rating_overall: 0,
      recommend: '',
      usage_time: '',
      message: document.getElementById(prefix + '-message').value,
      created_at: new Date().toISOString()
    });

    btn.classList.remove('submit-loading');
    const labels = { 'reclamação': 'Enviar Reclamação', 'sugestão': 'Enviar Sugestão', 'elogio': 'Enviar Elogio' };
    btn.querySelector('span').textContent = labels[type];

    if (result.isOk) {
      const cfg = window.elementSdk ? window.elementSdk.config : {};
      showToast(cfg.thank_you_message || defaultConfig.thank_you_message, 'success');
      form.reset();
    } else {
      showToast('Erro ao enviar. Tente novamente.', 'error');
    }
  }

  // Render history
  function renderHistory(data) {
    const list = document.getElementById('history-list');
    const empty = document.getElementById('history-empty');
    const sorted = [...data].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

    if (sorted.length === 0) {
      empty.classList.remove('hidden');
      list.innerHTML = '';
      return;
    }
    empty.classList.add('hidden');

    const existing = new Map([...list.children].map(el => [el.dataset.id, el]));
    const newIds = new Set(sorted.map(r => r.__backendId));

    // Remove old
    existing.forEach((el, id) => { if (!newIds.has(id)) el.remove(); });

    sorted.forEach((record, idx) => {
      const id = record.__backendId;
      let el = list.querySelector(`[data-id="${id}"]`);
      if (!el) {
        el = document.createElement('div');
        el.dataset.id = id;
        el.className = 'rounded-xl p-4 transition-all';
        el.style.cssText = 'background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);';
      }

      const typeColors = { pesquisa: '#6366f1', 'reclamação': '#f87171', 'sugestão': '#fbbf24', elogio: '#f472b6' };
      const typeIcons = { pesquisa: 'clipboard-list', 'reclamação': 'alert-circle', 'sugestão': 'lightbulb', elogio: 'heart' };
      const color = typeColors[record.type] || '#6366f1';
      const date = new Date(record.created_at);
      const dateStr = date.toLocaleDateString('pt-BR') + ' ' + date.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });

      let starsHtml = '';
      if (record.type === 'pesquisa' && record.rating_overall > 0) {
        starsHtml = '<div class="flex gap-0.5 mt-1">';
        for (let i = 1; i <= 5; i++) {
          starsHtml += `<svg width="14" height="14" viewBox="0 0 24 24" fill="${i <= record.rating_overall ? '#fbbf24' : 'none'}" stroke="${i <= record.rating_overall ? '#fbbf24' : '#4b5563'}" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;
        }
        starsHtml += '</div>';
      }

      el.innerHTML = `
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="inline-flex items-center gap-1 text-xs font-semibold px-2 py-0.5 rounded-full" style="background: ${color}22; color: ${color};">
                <i data-lucide="${typeIcons[record.type]}" style="width:12px;height:12px;"></i>
                ${record.type.charAt(0).toUpperCase() + record.type.slice(1)}
              </span>
              <span class="text-xs" style="color: #7c85b3;">${dateStr}</span>
            </div>
            <p class="text-sm font-medium" style="color: #e0e7ff;">${record.name}</p>
            ${starsHtml}
            ${record.message ? `<p class="text-xs mt-1 truncate" style="color: #9ca3af;">${record.message}</p>` : ''}
          </div>
        </div>`;

      if (!list.children[idx] || list.children[idx].dataset.id !== id) {
        if (list.children[idx]) {
          list.insertBefore(el, list.children[idx]);
        } else {
          list.appendChild(el);
        }
      }
    });

    lucide.createIcons();
  }

  // Data SDK init
  const dataHandler = {
    onDataChanged(data) {
      allData = data;
      renderHistory(data);
    }
  };

  // Element SDK
  const elementImpl = {
    defaultConfig,
    onConfigChange: async (config) => {
      const t = (k) => config[k] || defaultConfig[k];
      const font = t('font_family');
      const size = t('font_size');
      const bg = t('background_color');
      const text = t('text_color');
      const primary = t('primary_action_color');
      const secondary = t('secondary_action_color');

      document.getElementById('app').style.background = `linear-gradient(135deg, ${bg} 0%, ${bg}ee 50%, ${bg}dd 100%)`;
      document.getElementById('app').style.fontFamily = `${font}, sans-serif`;

      const title = document.getElementById('main-title');
      title.textContent = t('app_title');
      title.style.color = text;
      title.style.fontSize = `${size * 2.2}px`;

      const sub = document.getElementById('main-subtitle');
      sub.textContent = t('app_subtitle');
      sub.style.color = secondary;
      sub.style.fontSize = `${size * 1.2}px`;

      const intro = document.getElementById('intro-text');
      intro.textContent = t('survey_intro');
      intro.style.fontSize = `${size * 0.9}px`;

      document.querySelectorAll('h2').forEach(h => { h.style.color = text; h.style.fontSize = `${size * 1.4}px`; });
      document.querySelectorAll('label').forEach(l => { l.style.fontSize = `${size * 0.9}px`; });
      document.querySelectorAll('input, textarea, select').forEach(el => { el.style.fontSize = `${size}px`; });
    },
    mapToCapabilities: (config) => ({
      recolorables: [
        { get: () => config.background_color || defaultConfig.background_color, set: (v) => { config.background_color = v; window.elementSdk.setConfig({ background_color: v }); }},
        { get: () => config.surface_color || defaultConfig.surface_color, set: (v) => { config.surface_color = v; window.elementSdk.setConfig({ surface_color: v }); }},
        { get: () => config.text_color || defaultConfig.text_color, set: (v) => { config.text_color = v; window.elementSdk.setConfig({ text_color: v }); }},
        { get: () => config.primary_action_color || defaultConfig.primary_action_color, set: (v) => { config.primary_action_color = v; window.elementSdk.setConfig({ primary_action_color: v }); }},
        { get: () => config.secondary_action_color || defaultConfig.secondary_action_color, set: (v) => { config.secondary_action_color = v; window.elementSdk.setConfig({ secondary_action_color: v }); }}
      ],
      borderables: [],
      fontEditable: { get: () => config.font_family || defaultConfig.font_family, set: (v) => { config.font_family = v; window.elementSdk.setConfig({ font_family: v }); }},
      fontSizeable: { get: () => config.font_size || defaultConfig.font_size, set: (v) => { config.font_size = v; window.elementSdk.setConfig({ font_size: v }); }}
    }),
    mapToEditPanelValues: (config) => new Map([
      ['app_title', config.app_title || defaultConfig.app_title],
      ['app_subtitle', config.app_subtitle || defaultConfig.app_subtitle],
      ['survey_intro', config.survey_intro || defaultConfig.survey_intro],
      ['thank_you_message', config.thank_you_message || defaultConfig.thank_you_message]
    ])
  };

  // Init
  (async () => {
    if (window.elementSdk) window.elementSdk.init(elementImpl);
    const initResult = await window.dataSdk.init(dataHandler);
    if (!initResult.isOk) console.error('Data SDK init failed');
    buildStars();
    lucide.createIcons();
  })();
</script>
